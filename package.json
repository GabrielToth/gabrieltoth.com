        "@vitest/coverage-v8": "^5.1.0-beta.1",
        "chromedriver": "^157.0.1",
        "cspell": "^10.4.1",
        "cspell-dict-pt-br": "^1.1.1",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.5.0-canary.48",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^11.0.0-beta.1",
        "fast-check": "^4.10.2",
        "husky": "^9.1.7",
        "image-size": "^2.1.0",
        "jsdom": "^31.0.0",
        "lint-staged": "^17.6.0",
        "markdownlint-cli2": "^0.24.1",
        "node-fetch": "^4.0.0-beta.4",
        "prettier": "^4.0.0-alpha.13",
        "selenium-webdriver": "^4.52.0",
        "storybook": "^11.0.0-beta.1",
        "supabase": "^4.0.0-next.16",
        "tailwindcss": "^4.3.5",
        "tar-fs": "^3.1.3",
